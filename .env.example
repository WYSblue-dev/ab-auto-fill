# Get these values for correct connection to the api.

# Administered from the admin.
ACTION_BUILDER_API_KEY=your_actual_api_key
# The prefix for the .actionbuilder.
ACTION_BUILDER_SUBDOMAIN=your_actual_subdomain
# The id associated with desired campaign.
ACTION_BUILDER_CAMPAIGN_ID=your_actual_campaign_id

# Member automation: enter the single constant residence-local tag response.
# This enables the PDF classification tag, the constant residence-local tag,
# and assessment 1. No local number is hard-coded; fill in your own value.
# An empty value retains the legacy contact-only workflow for old records.
ACTION_BUILDER_RESIDENCE_LOCAL=
# Out-of-jurisdiction notes are pending an authoritative jurisdiction map.
